# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required to deliver contact form submissions to nexoradigital1143@gmail.com
# Obtain your free API key at https://resend.com/api-keys
# Add this in Vercel Project Settings > Environment Variables
RESEND_API_KEY="re_your_resend_api_key_here"

# RESEND_FROM_EMAIL: Optional custom sender address (e.g. "Nexora <contact@yourdomain.com>")
# Defaults to "Nexora Digital <onboarding@resend.dev>" if omitted
RESEND_FROM_EMAIL="Nexora Digital <onboarding@resend.dev>"
